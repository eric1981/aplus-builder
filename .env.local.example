# ============ aplus-builder 环境变量示例（复制为 .env.local 后填写）============
# 注意：.env.local 已在 .gitignore 中，切勿提交真实密钥。

# --- LLM（服务端用：产品名识别 / 市场预测；agent 自己的模型密钥在 ~/.hermes/profiles/duma/.env）---
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-1-5-vision-pro-32k-250115

# --- 初始管理员（首次启动创建/校正；设置后会以该密码为准）---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请改成强密码

# --- 支付回调验签（不设置则 /api/payments/webhook 直接 503；接微信/支付宝时必填）---
PAYMENT_WEBHOOK_SECRET=

# --- 路径（生产建议：产出放数据盘，hermes 放在运行用户 HOME 下）---
OUTPUT_BASE=/data/aplus-builder
AGENT_HOME=/home/aplus
HERMES_BIN=/home/aplus/.local/bin/hermes
CHROME_PATH=/usr/bin/google-chrome

# --- 反向代理与安全 ---
# Nginx 单层反代填 1（限流取真实客户端 IP）；直连填 0
TRUSTED_PROXY_HOPS=1
# 本机免登录：生产必须 false（即便 true 也仍需 ALLOW_LOCALHOST_ADMIN=1 才生效）
TRUST_LOCALHOST=false
ALLOW_LOCALHOST_ADMIN=0
TZ=Asia/Shanghai
